# Anthropic (for AI job extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL="file:./dev.db"

# App password (shared login gate)
APP_PASSWORD=changeme

# Session secret (random string, change this)
SESSION_SECRET=change-this-to-a-random-string

# SMTP (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-address@gmail.com

# Scheduled checks: an external cron calls
#   POST /api/cron/run  with header  Authorization: Bearer $CRON_SECRET
CRON_SECRET=generate-a-long-random-string

# Production only
# NODE_ENV=production
# PORT=3001
# CLIENT_ORIGIN=https://your-domain.com
